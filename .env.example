# Environment variables for Adversoft

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/adversoft"

# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key

# Cloud storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_BUCKET_REGION=

# Email provider
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=

# Other APIs
# ...