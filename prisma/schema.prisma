// Adversoft — Database Schema (Prisma ORM)
// Enterprise Outdoor Advertising Management Platform (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. ENUMS (Lifecycle & Statuses)
// ==========================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SALES_MANAGER
  SALES_AGENT
  CAMPAIGN_MANAGER
  OPERATIONS_MANAGER
  FINANCE
  TECHNICIAN
  CLIENT
}

enum ClientStatus {
  LEAD
  PROSPECT
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATING
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  MARKETPLACE
  INBOUND_CALL
  REFERRAL
  OUTBOUND_SALES
  TRADE_SHOW
  OTHER
}

enum BillboardType {
  STATIC_BULLETIN
  DIGITAL_LED
  UNIPOLE
  GANTRY
  BRIDGE_BANNER
  WALLSCAPE
  BUS_SHELTER
  KIOSK
  SPECTACULAR
}

enum BillboardOrientation {
  NORTH
  SOUTH
  EAST
  WEST
  NORTHEAST
  NORTHWEST
  SOUTHEAST
  SOUTHWEST
  PARALLEL
  PERPENDICULAR
}

enum IlluminationType {
  FRONTLIT_HALOGEN
  FRONTLIT_LED
  BACKLIT
  DIGITAL_SCREEN
  SOLAR_POWERED
  UNLIT
}

enum BillboardStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  MAINTENANCE
  INACTIVE
}

enum BookingStatus {
  DRAFT
  PENDING_REVIEW
  RESERVED
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ContractStatus {
  DRAFT
  PENDING_SIGNATURE
  SIGNED
  ACTIVE
  AMENDED
  EXPIRED
  TERMINATED
}

enum CampaignStatus {
  PLANNING
  AWAITING_APPROVAL
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum ArtworkStatus {
  DRAFT
  SUBMITTED
  INTERNAL_REVIEW
  CLIENT_REVIEW
  APPROVED
  REVISION_REQUESTED
  REJECTED
}

enum InstallationStatus {
  QUEUED
  SCHEDULED
  CREW_ASSIGNED
  IN_PROGRESS
  INSTALLED
  VERIFIED
  ISSUE_REPORTED
  TAKEDOWN_SCHEDULED
  REMOVED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

enum MaintenanceIssueType {
  VINYL_TEAR
  LIGHTING_OUTAGE
  DIGITAL_SCREEN_FAULT
  STRUCTURAL_DAMAGE
  GRAFFITI_VANDALISM
  STORM_DAMAGE
  VEGETATION_CLEARANCE
  ROUTINE_INSPECTION
}

enum MaintenanceStatus {
  REPORTED
  INVESTIGATING
  SCHEDULED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  DISPUTED
  VOID
}

enum PaymentMethod {
  WIRE_TRANSFER
  CREDIT_CARD
  ACH
  CHECK
  CASH
  ONLINE_GATEWAY
}

enum DocumentCategory {
  CONTRACT
  PROPOSAL
  ARTWORK_PRINT
  INVOICE
  PROOF_OF_POSTING
  PERMIT_LICENSE
  MAINTENANCE_REPORT
  CLIENT_BRIEF
  OTHER
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  URGENT
}

enum ActivityAction {
  CREATED
  UPDATED
  DELETED
  STATUS_CHANGED
  APPROVED
  REJECTED
  ASSIGNED
  SIGNATURE_SUBMITTED
  PAYMENT_RECORDED
  DISPATCHED
}

// ==========================================
// 2. ORGANIZATIONS, USERS & PERMISSIONS
// ==========================================

model Organization {
  id              String       @id @default(cuid())
  name            String
  slug            String       @unique
  legalName       String?
  taxId           String?
  logoUrl         String?
  primaryEmail    String
  primaryPhone    String?
  currency        String       @default("USD")
  address         String?
  city            String?
  state           String?
  country         String       @default("US")
  zipCode         String?
  settings        Json?        @default("{}")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  users           User[]
  clients         Client[]
  billboards      Billboard[]
  bookings        Booking[]
  campaigns       Campaign[]
  quotations      Quotation[]
  contracts       Contract[]
  invoices        Invoice[]
  maintenanceJobs MaintenanceRecord[]
}

model User {
  id              String        @id @default(cuid())
  organizationId  String?
  email           String        @unique
  passwordHash    String?
  name            String
  phone           String?
  avatarUrl       String?
  role            UserRole      @default(ADMIN)
  title           String?
  isActive        Boolean       @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadsAssigned   Lead[]        @relation("AssignedSalesAgent")
  campaignsManaged Campaign[]   @relation("CampaignManager")
  installationsLed Installation[] @relation("AssignedCrewLead")
  artworkUploaded ArtworkVersion[] @relation("UploadedArtwork")
  approvalsGiven  ArtworkApproval[] @relation("ApprovedByUser")
  maintenanceAssigned MaintenanceRecord[] @relation("AssignedTechnician")
  activityLogs    ActivityLog[]
  notifications   Notification[]

  @@index([organizationId])
  @@index([email])
}

// ==========================================
// 3. CRM: CLIENTS, CONTACTS & LEADS
// ==========================================

model Client {
  id              String        @id @default(cuid())
  organizationId  String
  accountNumber   String        @unique // e.g. CLI-1001
  companyName     String
  dbaName         String?
  industry        String?
  status          ClientStatus  @default(ACTIVE)
  billingAddress  String?
  city            String?
  state           String?
  zipCode         String?
  country         String        @default("US")
  website         String?
  taxId           String?
  creditLimit     Decimal?      @db.Decimal(12, 2)
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts        ClientContact[]
  leads           Lead[]
  bookings        Booking[]
  campaigns       Campaign[]
  quotations      Quotation[]
  contracts       Contract[]
  invoices        Invoice[]
  payments        Payment[]
  documents       Document[]

  @@index([organizationId])
  @@index([companyName])
}

model ClientContact {
  id              String       @id @default(cuid())
  clientId        String
  firstName       String
  lastName        String
  title           String?
  email           String
  phone           String?
  isPrimary       Boolean      @default(false)
  isBilling       Boolean      @default(false)
  portalAccess    Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  client          Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model Lead {
  id              String       @id @default(cuid())
  clientId        String?
  assignedToId    String?
  title           String
  companyName     String
  contactName     String
  contactEmail    String
  contactPhone    String?
  source          LeadSource   @default(WEBSITE)
  status          LeadStatus   @default(NEW)
  estimatedValue  Decimal?     @db.Decimal(12, 2)
  targetFlightStart DateTime?
  targetFlightEnd   DateTime?
  preferredLocations String?   // Comma separated or description
  notes           String?      @db.Text
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  client          Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignedTo      User?        @relation("AssignedSalesAgent", fields: [assignedToId], references: [id], onDelete: SetNull)
  quotations      Quotation[]

  @@index([status])
  @@index([assignedToId])
}

// ==========================================
// 4. BILLBOARD INVENTORY & LOCATIONS
// ==========================================

model BillboardLocation {
  id              String       @id @default(cuid())
  address         String
  city            String
  state           String
  zipCode         String
  country         String       @default("US")
  corridorName    String?      // e.g. I-95 Northbound Exit 42
  metroArea       String?      // e.g. Greater New York Area
  latitude        Decimal      @db.Decimal(10, 7)
  longitude       Decimal      @db.Decimal(10, 7)
  dailyTrafficCount Int?       // DEC / Daily Effective Circulation
  averageSpeedMph Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  billboards      Billboard[]

  @@index([city, state])
  @@index([latitude, longitude])
}

model Billboard {
  id              String              @id @default(cuid())
  organizationId  String
  locationId      String
  code            String              @unique // e.g. BB-101
  name            String              // e.g. Downtown Metro Unipole Face A
  type            BillboardType       @default(STATIC_BULLETIN)
  orientation     BillboardOrientation @default(PARALLEL)
  illumination    IlluminationType    @default(FRONTLIT_LED)
  status          BillboardStatus     @default(AVAILABLE)

  // Physical Dimensions
  widthFeet       Decimal             @db.Decimal(6, 2)
  heightFeet      Decimal             @db.Decimal(6, 2)
  squareFeet      Decimal             @db.Decimal(8, 2)
  isDigital       Boolean             @default(false)
  digitalSlots    Int?                @default(1) // Number of shared slots for digital screens
  slotDurationSeconds Int?            @default(8)

  // Standard Pricing
  dailyRate       Decimal             @db.Decimal(10, 2)
  weeklyRate      Decimal             @db.Decimal(10, 2)
  monthlyRate     Decimal             @db.Decimal(10, 2)
  productionCost  Decimal?            @db.Decimal(10, 2) // Printing vinyl cost
  installationCost Decimal?           @db.Decimal(10, 2) // Rigging & mounting

  // Operational Specs
  photos          String[]            @default([]) // URLs
  specSheetUrl    String?
  description     String?             @db.Text
  isMarketplaceListed Boolean         @default(true)
  minBookingDays  Int                 @default(14)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location        BillboardLocation   @relation(fields: [locationId], references: [id], onDelete: Restrict)
  bookingItems    BookingItem[]
  campaignItems   CampaignItem[]
  installations   Installation[]
  maintenanceRecords MaintenanceRecord[]

  @@index([organizationId])
  @@index([status])
  @@index([type])
}

// ==========================================
// 5. COMMERCIAL: QUOTATIONS, BOOKINGS & CONTRACTS
// ==========================================

model Quotation {
  id              String          @id @default(cuid())
  organizationId  String
  clientId        String
  leadId          String?
  quotationNumber String          @unique // e.g. QUO-2026-001
  status          QuotationStatus @default(DRAFT)
  issueDate       DateTime        @default(now())
  validUntil      DateTime
  subtotal        Decimal         @db.Decimal(12, 2)
  discountTotal   Decimal         @default(0.00) @db.Decimal(12, 2)
  taxRatePercent  Decimal         @default(0.00) @db.Decimal(5, 2)
  taxAmount       Decimal         @default(0.00) @db.Decimal(12, 2)
  totalAmount     Decimal         @db.Decimal(12, 2)
  notes           String?         @db.Text
  termsConditions String?         @db.Text
  pdfUrl          String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client          Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  lead            Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  items           QuotationItem[]
  bookings        Booking[]
  contracts       Contract[]

  @@index([organizationId])
  @@index([clientId])
  @@index([status])
}

model QuotationItem {
  id              String       @id @default(cuid())
  quotationId     String
  billboardCode   String?
  description     String
  startDate       DateTime
  endDate         DateTime
  quantity        Int          @default(1)
  unitPrice       Decimal      @db.Decimal(10, 2)
  discount        Decimal      @default(0.00) @db.Decimal(10, 2)
  totalPrice      Decimal      @db.Decimal(10, 2)

  quotation       Quotation    @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

model Booking {
  id              String        @id @default(cuid())
  organizationId  String
  clientId        String
  quotationId     String?
  bookingNumber   String        @unique // e.g. BKG-2026-001
  status          BookingStatus @default(DRAFT)
  startDate       DateTime
  endDate         DateTime
  holdExpiresAt   DateTime?     // Automated release timer for holds
  totalAmount     Decimal       @db.Decimal(12, 2)
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client          Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  quotation       Quotation?    @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  items           BookingItem[]
  campaigns       Campaign[]
  contracts       Contract[]

  @@index([organizationId])
  @@index([clientId])
  @@index([status])
  @@index([startDate, endDate])
}

model BookingItem {
  id              String       @id @default(cuid())
  bookingId       String
  billboardId     String
  startDate       DateTime
  endDate         DateTime
  rateType        String       @default("MONTHLY") // DAILY, WEEKLY, MONTHLY
  agreedRate      Decimal      @db.Decimal(10, 2)
  subtotal        Decimal      @db.Decimal(10, 2)

  booking         Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  billboard       Billboard    @relation(fields: [billboardId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([billboardId])
  @@index([startDate, endDate])
}

model Contract {
  id              String         @id @default(cuid())
  organizationId  String
  clientId        String
  bookingId       String?
  quotationId     String?
  contractNumber  String         @unique // e.g. CNT-2026-001
  title           String
  status          ContractStatus @default(DRAFT)
  startDate       DateTime
  endDate         DateTime
  totalValue      Decimal        @db.Decimal(12, 2)
  paymentTermsDays Int           @default(30)
  signedAt        DateTime?
  signerName      String?
  signerEmail     String?
  documentUrl     String?
  renewalNoticeDays Int          @default(60)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client          Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  booking         Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  quotation       Quotation?     @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  campaigns       Campaign[]
  invoices        Invoice[]

  @@index([organizationId])
  @@index([clientId])
  @@index([status])
}

// ==========================================
// 6. CAMPAIGN MANAGEMENT WORKSPACES
// ==========================================

model Campaign {
  id              String         @id @default(cuid())
  organizationId  String
  clientId        String
  bookingId       String?
  contractId      String?
  managerId       String?
  campaignCode    String         @unique // e.g. CMP-2026-001
  name            String         // e.g. Summer Festival 2026 Flight
  brandName       String?
  status          CampaignStatus @default(PLANNING)
  flightStart     DateTime
  flightEnd       DateTime
  budget          Decimal        @db.Decimal(12, 2)
  targetDemographic String?
  keyObjectives   String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client          Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  booking         Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  contract        Contract?      @relation(fields: [contractId], references: [id], onDelete: SetNull)
  manager         User?          @relation("CampaignManager", fields: [managerId], references: [id], onDelete: SetNull)
  items           CampaignItem[]
  artworks        Artwork[]
  installations   Installation[]
  invoices        Invoice[]
  documents       Document[]

  @@index([organizationId])
  @@index([clientId])
  @@index([status])
  @@index([flightStart, flightEnd])
}

model CampaignItem {
  id              String       @id @default(cuid())
  campaignId      String
  billboardId     String
  flightStart     DateTime
  flightEnd       DateTime
  ratePerMonth    Decimal      @db.Decimal(10, 2)
  totalCost       Decimal      @db.Decimal(10, 2)

  campaign        Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  billboard       Billboard    @relation(fields: [billboardId], references: [id], onDelete: Restrict)

  @@index([campaignId])
  @@index([billboardId])
}

// ==========================================
// 7. ARTWORK & APPROVAL WORKFLOW
// ==========================================

model Artwork {
  id              String         @id @default(cuid())
  campaignId      String
  title           String         // e.g. Billboard Face A Creative - High Res
  artworkCode     String         @unique // e.g. ART-101
  status          ArtworkStatus  @default(DRAFT)
  currentVersion  Int            @default(1)
  dimensionsText  String?        // e.g. 14ft x 48ft
  aspectRatio     String?        // e.g. 24:7
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  campaign        Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  versions        ArtworkVersion[]
  installations   Installation[]

  @@index([campaignId])
  @@index([status])
}

model ArtworkVersion {
  id              String         @id @default(cuid())
  artworkId       String
  versionNumber   Int            // 1, 2, 3...
  fileUrl         String
  thumbnailUrl    String?
  fileSizeBytes   Int?
  resolutionDpi   Int?
  uploadedById    String
  changeNotes     String?        @db.Text
  createdAt       DateTime       @default(now())

  artwork         Artwork        @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  uploadedBy      User           @relation("UploadedArtwork", fields: [uploadedById], references: [id], onDelete: Restrict)
  approvals       ArtworkApproval[]

  @@unique([artworkId, versionNumber])
  @@index([artworkId])
}

model ArtworkApproval {
  id              String         @id @default(cuid())
  versionId       String
  approvedById    String
  isApproved      Boolean
  comments        String?        @db.Text
  approvedAt      DateTime       @default(now())

  version         ArtworkVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  approvedBy      User           @relation("ApprovedByUser", fields: [approvedById], references: [id], onDelete: Restrict)

  @@index([versionId])
}

// ==========================================
// 8. FIELD OPERATIONS & INSTALLATIONS
// ==========================================

model Installation {
  id              String             @id @default(cuid())
  billboardId     String
  campaignId      String
  artworkId       String?
  assignedCrewId  String?
  jobNumber       String             @unique // e.g. INS-2026-001
  status          InstallationStatus @default(QUEUED)
  scheduledDate   DateTime
  installedDate   DateTime?
  verifiedDate    DateTime?
  instructions    String?            @db.Text
  beforePhotos    String[]           @default([])
  afterPhotos     String[]           @default([]) // Proof of posting photos
  verificationGps String?            // Verified coordinates from field app
  signoffNotes    String?            @db.Text
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  billboard       Billboard          @relation(fields: [billboardId], references: [id], onDelete: Restrict)
  campaign        Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  artwork         Artwork?           @relation(fields: [artworkId], references: [id], onDelete: SetNull)
  assignedCrew    User?              @relation("AssignedCrewLead", fields: [assignedCrewId], references: [id], onDelete: SetNull)

  @@index([billboardId])
  @@index([campaignId])
  @@index([status])
}

// ==========================================
// 9. MAINTENANCE & REPAIRS
// ==========================================

model MaintenanceRecord {
  id              String               @id @default(cuid())
  organizationId  String
  billboardId     String
  assignedToId    String?
  workOrderNumber String               @unique // e.g. MNT-2026-001
  priority        MaintenancePriority  @default(MEDIUM)
  issueType       MaintenanceIssueType @default(ROUTINE_INSPECTION)
  status          MaintenanceStatus    @default(REPORTED)
  reportedAt      DateTime             @default(now())
  scheduledAt     DateTime?
  resolvedAt      DateTime?
  cost            Decimal?             @db.Decimal(10, 2)
  description     String               @db.Text
  resolutionNotes String?              @db.Text
  photosBefore    String[]             @default([])
  photosAfter     String[]             @default([])
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billboard       Billboard            @relation(fields: [billboardId], references: [id], onDelete: Restrict)
  assignedTo      User?                @relation("AssignedTechnician", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([billboardId])
  @@index([status])
  @@index([priority])
}

// ==========================================
// 10. FINANCIAL: INVOICING & PAYMENTS
// ==========================================

model Invoice {
  id              String        @id @default(cuid())
  organizationId  String
  clientId        String
  campaignId      String?
  contractId      String?
  invoiceNumber   String        @unique // e.g. INV-2026-001
  status          InvoiceStatus @default(DRAFT)
  issueDate       DateTime      @default(now())
  dueDate         DateTime
  subtotal        Decimal       @db.Decimal(12, 2)
  taxRate         Decimal       @default(0.00) @db.Decimal(5, 2)
  taxAmount       Decimal       @default(0.00) @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0.00) @db.Decimal(12, 2)
  totalAmount     Decimal       @db.Decimal(12, 2)
  paidAmount      Decimal       @default(0.00) @db.Decimal(12, 2)
  balanceDue      Decimal       @db.Decimal(12, 2)
  notes           String?       @db.Text
  paymentTerms    String?       // Net 30, Due on Receipt
  pdfUrl          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client          Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  campaign        Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contract        Contract?     @relation(fields: [contractId], references: [id], onDelete: SetNull)
  items           InvoiceItem[]
  payments        Payment[]

  @@index([organizationId])
  @@index([clientId])
  @@index([status])
  @@index([dueDate])
}

model InvoiceItem {
  id              String       @id @default(cuid())
  invoiceId       String
  description     String
  quantity        Int          @default(1)
  unitPrice       Decimal      @db.Decimal(10, 2)
  amount          Decimal      @db.Decimal(10, 2)

  invoice         Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id              String        @id @default(cuid())
  invoiceId       String
  clientId        String
  paymentNumber   String        @unique // e.g. PAY-2026-001
  amount          Decimal       @db.Decimal(12, 2)
  paymentMethod   PaymentMethod @default(WIRE_TRANSFER)
  referenceNumber String?       // Check number, wire ref, or stripe transaction id
  paymentDate     DateTime      @default(now())
  notes           String?
  createdAt       DateTime      @default(now())

  invoice         Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  client          Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([clientId])
}

// ==========================================
// 11. CENTRALIZED DOCUMENTS & FILES
// ==========================================

model Document {
  id              String           @id @default(cuid())
  clientId        String?
  campaignId      String?
  title           String
  category        DocumentCategory @default(OTHER)
  fileUrl         String
  fileSizeBytes   Int?
  mimeType        String?
  uploadedAt      DateTime         @default(now())

  client          Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  campaign        Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([campaignId])
}

// ==========================================
// 12. NOTIFICATIONS & AUDIT ACTIVITY LOGS
// ==========================================

model Notification {
  id              String               @id @default(cuid())
  userId          String
  title           String
  message         String               @db.Text
  severity        NotificationSeverity @default(INFO)
  entityType      String?              // e.g. BOOKING, ARTWORK, INVOICE
  entityId        String?
  isRead          Boolean              @default(false)
  createdAt       DateTime             @default(now())

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model ActivityLog {
  id              String         @id @default(cuid())
  userId          String?
  action          ActivityAction
  entityType      String         // e.g. BILLBOARD, BOOKING, CAMPAIGN, ARTWORK, INVOICE
  entityId        String
  description     String
  metadata        Json?          @default("{}")
  ipAddress       String?
  createdAt       DateTime       @default(now())

  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
